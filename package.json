{
  "name": "muit-event-management-system",
  "version": "1.0.0",
  "description": "Full-Stack MUIT Event Management System with React, Node.js, Express, and MongoDB",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server && node utils/seed.js",
    "build": "cd client && npm install && npm run build"
  },
  "keywords": [
    "college",
    "event-management",
    "react",
    "nodejs",
    "mongodb",
    "qr-code",
    "attendance"
  ],
  "author": "MUIT",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
