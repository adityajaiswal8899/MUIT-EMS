# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas Cloud)
# For Local: mongodb://127.0.0.1:27017/muit_event_db
# For Cloud (Vercel/Production): mongodb+srv://<username>:<password>@cluster0.mongodb.net/muit_event_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/muit_event_db

# JWT Secret Key for Token Authentication
JWT_SECRET=muit_super_secret_jwt_key_2026_production_grade

# Frontend URL (For CORS whitelist)
# In production, set to your Vercel URL, e.g. https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
